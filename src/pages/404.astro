---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page Not Found — apeLabs" description="The page you're looking for doesn't exist.">
  <div class="flex min-h-screen flex-col items-center justify-center px-6 text-center">
    <p class="text-8xl font-extrabold gradient-text">404</p>
    <h1 class="mt-4 text-2xl font-bold text-white">Page not found</h1>
    <p class="mt-2 text-gray-400">The page you're looking for doesn't exist or has been moved.</p>
    <a
      href="/"
      class="mt-8 rounded-full bg-gradient-to-r from-brand-500 to-brand-400 px-8 py-3 font-medium text-white glow-btn"
    >
      Back to Home
    </a>
  </div>
</BaseLayout>
