---
const achievements = [
  {
    icon: "🤖",
    title: "Production AI Systems",
    description: "Designed and deployed LLM-powered solutions handling live customer interactions with RAG architecture and vector search",
  },
  {
    icon: "⚡",
    title: "Scalable API Architecture",
    description: "Built partner integration framework that became the standard for all new lender onboarding",
  },
  {
    icon: "🔗",
    title: "Complex System Integration",
    description: "Architected bidirectional sync between legacy platforms and modern infrastructure",
  },
  {
    icon: "📊",
    title: "End-to-End Ownership",
    description: "From technical discovery through deployment: architecture, implementation, documentation, training",
  },
  {
    icon: "🛡️",
    title: "Security & Compliance",
    description: "Led SOC 2 penetration testing initiative and remediation across the full stack",
  },
];
---

<section class="relative py-24 md:py-32">
  <div class="mx-auto max-w-6xl px-6">
    <div class="gradient-divider mb-16"></div>

    <h2 class="mb-16 text-3xl font-bold md:text-4xl fade-in">
      Key <span class="gradient-text">Achievements</span>
    </h2>

    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {
        achievements.map((a, i) => (
          <div
            class="rounded-2xl border border-white/5 bg-surface p-6 transition-all duration-300 hover:border-brand-500/30 hover:shadow-lg hover:shadow-brand-500/5 hover:-translate-y-1 fade-in"
            style={`transition-delay: ${i * 0.1}s;`}
          >
            <span class="text-2xl">{a.icon}</span>
            <h3 class="mt-3 text-lg font-semibold text-white">{a.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-gray-400">{a.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
