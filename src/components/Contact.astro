        <a href="tel:+13237602801" class="transition-colors hover:text-gray-300">(323) 760-2801</a>
        <span>&middot;</span>
        <a href="mailto:arspesk@gmail.com" class="transition-colors hover:text-gray-300">arspesk@gmail.com</a>
