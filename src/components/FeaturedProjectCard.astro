---
import type { Project } from "../data/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article
  class="group overflow-hidden rounded-2xl border border-white/5 bg-surface transition-all duration-300 hover:border-brand-500/30 hover:shadow-xl hover:shadow-brand-500/5 fade-in"
>
  <div class="grid lg:grid-cols-2">
    <!-- Media -->
    <div class="overflow-hidden bg-black">
      {project.video ? (
        <video
          src={project.video}
          poster={project.image}
          controls
          preload="none"
          playsinline
          class="h-56 w-full object-cover sm:h-72 lg:h-full lg:min-h-[420px]"
          style={project.imagePosition ? `object-position: ${project.imagePosition}` : undefined}
        ></video>
      ) : (
        <img
          src={project.image}
          alt={project.title}
          class="h-56 w-full object-cover sm:h-72 lg:h-full lg:min-h-[420px]"
          style={project.imagePosition ? `object-position: ${project.imagePosition}` : undefined}
          loading="lazy"
        />
      )}
    </div>

    <!-- Content -->
    <div class="flex flex-col p-7 md:p-9 lg:p-10">
      <div class="mb-4 flex items-start justify-between gap-4">
        <div>
          <span class="text-2xl">{project.icon}</span>
          <h3 class="mt-2 text-2xl font-semibold text-white md:text-3xl">{project.title}</h3>
          <p class="mt-1 text-sm text-gray-500">{project.date}</p>
        </div>
        <span class="shrink-0 rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs text-gray-400">
          {project.category}
        </span>
      </div>

      <p class="mb-6 text-sm leading-relaxed text-gray-400 md:text-base">{project.description}</p>

      <!-- Tech stack -->
      <div class="mb-6">
        <p class="mb-2 text-xs font-medium uppercase tracking-widest text-brand-400">Stack</p>
        <div class="flex flex-wrap gap-1.5">
          {project.tech.map((t) => (
            <span class="rounded-md bg-brand-500/10 px-2 py-0.5 text-xs text-brand-400">{t}</span>
          ))}
        </div>
      </div>

      <!-- Results -->
      <div class="mt-auto">
        <p class="mb-2 text-xs font-medium uppercase tracking-widest text-gray-500">Results</p>
        <ul class="grid gap-1 sm:grid-cols-2">
          {project.results.map((r) => (
            <li class="flex items-start gap-2 text-sm text-gray-400">
              <span class="mt-1.5 h-1 w-1 flex-shrink-0 rounded-full bg-brand-500"></span>
              {r}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</article>
