---
import type { Project } from "../data/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article
  class="group overflow-hidden rounded-2xl border border-white/5 bg-surface transition-all duration-300 hover:border-brand-500/30 hover:shadow-xl hover:shadow-brand-500/5 fade-in"
>
  <!-- Media: full-width preview on top (full frame, not cropped) -->
  <div class="bg-black">
    {project.video ? (
      <video
        src={project.video}
        poster={project.image}
        controls
        preload="none"
        playsinline
        class="block aspect-[1662/1080] w-full"
      ></video>
    ) : (
      <img
        src={project.image}
        alt={project.title}
        loading="lazy"
        class="block aspect-[1662/1080] w-full object-cover"
      />
    )}
  </div>

  <!-- Content -->
  <div class="p-7 md:p-10">
    <div class="mb-4 flex items-start justify-between gap-4">
      <div>
        <span class="text-2xl">{project.icon}</span>
        <h3 class="mt-2 text-2xl font-semibold text-white md:text-3xl">{project.title}</h3>
        <p class="mt-1 text-sm text-gray-500">{project.date}</p>
      </div>
      <span class="shrink-0 rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs text-gray-400">
        {project.category}
      </span>
    </div>

    <p class="mb-6 max-w-3xl text-sm leading-relaxed text-gray-400 md:text-base">{project.description}</p>

    {project.links && project.links.length > 0 && (
      <div class="mb-8 flex flex-wrap gap-3">
        {project.links.map((link, i) => (
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            class={i === 0
              ? "inline-flex items-center gap-1.5 rounded-lg bg-brand-500 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-brand-400"
              : "inline-flex items-center gap-1.5 rounded-lg border border-white/10 bg-white/5 px-4 py-2 text-sm font-medium text-gray-300 transition-colors hover:border-brand-500/40 hover:text-white"}
          >
            {link.label}
            <span aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    )}

    <div class="grid gap-8 md:grid-cols-2">
      <div>
        <p class="mb-2 text-xs font-medium uppercase tracking-widest text-brand-400">Stack</p>
        <div class="flex flex-wrap gap-1.5">
          {project.tech.map((t) => (
            <span class="rounded-md bg-brand-500/10 px-2 py-0.5 text-xs text-brand-400">{t}</span>
          ))}
        </div>
      </div>
      <div>
        <p class="mb-2 text-xs font-medium uppercase tracking-widest text-gray-500">Results</p>
        <ul class="space-y-1">
          {project.results.map((r) => (
            <li class="flex items-start gap-2 text-sm text-gray-400">
              <span class="mt-1.5 h-1 w-1 flex-shrink-0 rounded-full bg-brand-500"></span>
              {r}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</article>
