---

---

<section id="education" class="relative py-24 md:py-32">
  <div class="mx-auto max-w-6xl px-6">
    <div class="gradient-divider mb-16"></div>

    <h2 class="mb-16 text-3xl font-bold md:text-4xl fade-in">
      Education & <span class="gradient-text">Certifications</span>
    </h2>

    <div class="grid gap-8 md:grid-cols-2">
      <!-- Education -->
      <div
        class="rounded-2xl border border-white/5 bg-surface p-6 transition-all duration-300 hover:border-brand-500/30 hover:-translate-y-1 fade-in"
        style="transition-delay: 0.1s;"
      >
        <h3 class="mb-6 text-sm font-semibold uppercase tracking-widest text-brand-400">
          Education
        </h3>
        <div class="space-y-5">
          <div>
            <p class="font-semibold text-white">QA Engineering</p>
            <p class="text-sm text-gray-400">TripleTen</p>
          </div>
          <div>
            <p class="font-semibold text-white">Computer Science</p>
            <p class="text-sm text-gray-400">Moscow State University</p>
          </div>
        </div>
      </div>

      <!-- Certifications -->
      <div
        class="rounded-2xl border border-white/5 bg-surface p-6 transition-all duration-300 hover:border-brand-500/30 hover:-translate-y-1 fade-in"
        style="transition-delay: 0.2s;"
      >
        <h3 class="mb-6 text-sm font-semibold uppercase tracking-widest text-brand-400">
          Certifications
        </h3>
        <div class="space-y-3">
          <div class="flex items-center gap-2">
            <span class="h-1.5 w-1.5 rounded-full bg-brand-500"></span>
            <p class="text-gray-300">Make.com — Basics, Foundation, HTTP, Webhooks</p>
          </div>
          <div class="flex items-center gap-2">
            <span class="h-1.5 w-1.5 rounded-full bg-brand-500"></span>
            <p class="text-gray-300">Meta Digital Marketing Associate</p>
          </div>
          <div class="flex items-center gap-2">
            <span class="h-1.5 w-1.5 rounded-full bg-brand-500"></span>
            <p class="text-gray-300">FreeCodeCamp Full-Stack <span class="text-gray-500">(in progress)</span></p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
