---
import { skillCategories } from "../data/skills";
---

<section id="skills" class="relative py-24 md:py-32">
  <div class="mx-auto max-w-6xl px-6">
    <div class="gradient-divider mb-16"></div>

    <h2 class="mb-16 text-3xl font-bold md:text-4xl fade-in">
      Technical <span class="gradient-text">Skills</span>
    </h2>

    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {
        skillCategories.map((cat, i) => (
          <div
            class="rounded-2xl border border-white/5 bg-surface p-6 transition-all duration-300 hover:border-brand-500/30 hover:shadow-lg hover:shadow-brand-500/5 hover:-translate-y-1 fade-in"
            style={`transition-delay: ${i * 0.1}s;`}
          >
            <h3 class="mb-4 text-sm font-semibold uppercase tracking-widest text-brand-400">
              {cat.name}
            </h3>
            <ul class="flex flex-wrap gap-2" role="list">
              {cat.items.map((skill) => (
                <li class="rounded-full border border-white/8 bg-white/5 px-3 py-1 text-sm text-gray-300">
                  {skill}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
