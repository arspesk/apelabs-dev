---
const navItems = [
  { label: "About", href: "#about" },
  { label: "Skills", href: "#skills" },
  { label: "Projects", href: "#projects" },
  { label: "Education", href: "#education" },
  { label: "Contact", href: "#contact" },
];
---

<header
  class="fixed top-0 left-0 right-0 z-50 border-b border-white/5 backdrop-blur-xl bg-[#0a0a0a]/80"
>
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <a href="/" class="flex items-center">
      <img src="/logo.png" alt="apelabs" class="h-12 md:h-14" />
    </a>

    <!-- Desktop nav -->
    <div class="hidden items-center gap-8 md:flex">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="text-sm text-gray-400 transition-colors hover:text-white"
          >
            {item.label}
          </a>
        ))
      }
      <a
        href="/assets/Arsenii_P_Resume.pdf"
        download
        class="rounded-full bg-gradient-to-r from-brand-500 to-brand-400 px-5 py-2 text-sm font-medium text-white glow-btn"
      >
        Resume
      </a>
    </div>

    <!-- Mobile hamburger -->
    <button
      id="menu-toggle"
      class="flex flex-col gap-1.5 md:hidden"
      aria-label="Toggle menu"
    >
      <span class="block h-0.5 w-6 bg-gray-400 transition-transform" id="bar1"
      ></span>
      <span class="block h-0.5 w-6 bg-gray-400 transition-opacity" id="bar2"
      ></span>
      <span class="block h-0.5 w-6 bg-gray-400 transition-transform" id="bar3"
      ></span>
    </button>
  </nav>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="hidden border-t border-white/5 bg-[#0a0a0a]/95 backdrop-blur-xl md:hidden"
  >
    <div class="flex flex-col gap-4 px-6 py-6">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="mobile-link text-gray-400 transition-colors hover:text-white"
          >
            {item.label}
          </a>
        ))
      }
      <a
        href="/assets/Arsenii_P_Resume.pdf"
        download
        class="mt-2 inline-block rounded-full bg-gradient-to-r from-brand-500 to-brand-400 px-5 py-2 text-center text-sm font-medium text-white"
      >
        Resume
      </a>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const bar1 = document.getElementById("bar1");
  const bar2 = document.getElementById("bar2");
  const bar3 = document.getElementById("bar3");

  toggle?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden") === false;
    bar1?.style.setProperty("transform", open ? "rotate(45deg) translate(4px, 4px)" : "none");
    bar2?.style.setProperty("opacity", open ? "0" : "1");
    bar3?.style.setProperty("transform", open ? "rotate(-45deg) translate(4px, -4px)" : "none");
  });

  document.querySelectorAll(".mobile-link").forEach((link) => {
    link.addEventListener("click", () => {
      menu?.classList.add("hidden");
      bar1?.style.setProperty("transform", "none");
      bar2?.style.setProperty("opacity", "1");
      bar3?.style.setProperty("transform", "none");
    });
  });
</script>
