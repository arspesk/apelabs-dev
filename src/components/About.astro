<section id="about" class="relative py-24 md:py-32">
  <div class="mx-auto max-w-6xl px-6">
    <div class="gradient-divider mb-16"></div>

    <h2 class="mb-16 text-3xl font-bold md:text-4xl fade-in">
      About <span class="gradient-text">Me</span>
    </h2>

    <div class="grid gap-12 md:grid-cols-5">
      <!-- Bio -->
      <div class="md:col-span-3 fade-in" style="transition-delay: 0.1s;">
        <p class="mb-6 text-lg leading-relaxed text-gray-400">
          Senior Solutions Engineer with 3 production AI systems shipped in fintech — RAG pipeline,
          agentic SMS automation, and vector-search knowledge base. Full pre-sales cycle (discovery
          through POC) for 20+ enterprise partners, plus Stripe Connect architecture and SOC 2
          compliance implementation.
        </p>
        <p class="text-lg leading-relaxed text-gray-400">
          Started in QA (yes, I found <em>all</em> the bugs), pivoted to solutions engineering,
          and now I'm deep in the AI/ML space building production systems. I believe in never
          stopping learning — and moving fast while doing it.
        </p>
      </div>

      <!-- Quick facts -->
      <div class="md:col-span-2 fade-in" style="transition-delay: 0.2s;">
        <div class="rounded-2xl border border-white/5 bg-surface p-6 space-y-5">
          <div>
            <p class="text-xs font-medium uppercase tracking-widest text-brand-400">Location</p>
            <p class="mt-1 text-gray-300">Los Angeles, CA</p>
          </div>
          <div>
            <p class="text-xs font-medium uppercase tracking-widest text-brand-400">Currently Into</p>
            <p class="mt-1 text-gray-300">LLMs, Vector Databases, Fintech</p>
          </div>
          <div>
            <p class="text-xs font-medium uppercase tracking-widest text-brand-400">Fun Fact</p>
            <p class="mt-1 text-gray-300">Completed QA bootcamp in 2 months instead of 5, then immediately got hired.</p>
          </div>
          <div>
            <p class="text-xs font-medium uppercase tracking-widest text-brand-400">Languages</p>
            <p class="mt-1 text-gray-300">English (fluent) &middot; Russian (native)</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
